DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_id
# Replace with a unique URL-safe password before deployment.
POSTGRES_PASSWORD=replace_with_unique_url_safe_password
# Compose overrides DATABASE_URL to use the internal db service (no host port).
DATABASE_URL=postgres://bibliotecario:replace_with_unique_url_safe_password@db:5432/bibliotecario
LOG_LEVEL=info
PORT=3050
# Both empty: dashboard disabled, bot continues. Password must be >=16 bytes.
DASHBOARD_ADMIN_USER=
DASHBOARD_ADMIN_PASSWORD=
# Direct HTTPS only for remote clients. PEM files readable by bot; no proxy mode.
DASHBOARD_TLS_CERT=
DASHBOARD_TLS_KEY=
OWNER_ID=852879300336418837